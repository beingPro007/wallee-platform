# Public browser configuration: NEVER place service-role or AWS keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-admin-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_MODAL_INGEST_URL=https://harrir-prod-2--wall-e-worker-ingest.modal.run
# Server-only wallpaper database (can be a different project from admin auth).
WALLEE_SUPABASE_URL=https://your-wallpaper-project.supabase.co
WALLEE_SUPABASE_SERVICE_KEY=replace-with-service-role-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=replace-with-bucket
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
CLOUDFRONT_URL=https://your-distribution.cloudfront.net
BUILD_WEBHOOK_SECRET=replace-with-a-random-secret
MODAL_APPROVE_DESKTOP_URL=https://harrir-prod-2--wall-e-upscaler-approve-desktop.modal.run
WALLPAPERS_V2_KEY=wallpapers_v2.json

# Comma-separated verified administrator emails. Empty means deny access.
OPS_ADMIN_EMAILS=admin@example.com
CLOUDFRONT_DISTRIBUTION_ID=replace-with-distribution-id
