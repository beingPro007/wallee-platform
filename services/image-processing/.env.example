# Local reference only. Modal deployment uses the existing named secret
# wallee-supabase-secrets in the harrir-prod-2 workspace.
MODAL_PROFILE=harrir-prod-2
SUPABASE_URL=https://your-wallpaper-project.supabase.co
SUPABASE_KEY=replace-with-service-role-key
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET_NAME=replace-with-bucket
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
CLOUDFRONT_BASE_URL=https://your-distribution.cloudfront.net
VERCEL_BUILD_URL=https://your-admin-domain/api/build-section-json
BUILD_WEBHOOK_SECRET=replace-with-the-same-admin-webhook-secret
WALLHAVEN_API_KEY=
DEDUP_ENABLED=1
DEDUP_THRESHOLD=0.95
DESKTOP_ENABLED=1
DESKTOP_AUTO_PUBLISH=0
DESKTOP_CONFIDENCE=0.85
WALLHAVEN_MAX_IMAGES=24
SESSION_SLUG=

# Desktop is paused pending a separately designed replacement architecture.
DESKTOP_PIPELINE_PAUSED=1
